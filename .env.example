# --- Database ---
# Local native install (winget PostgreSQL.PostgreSQL.16): postgres superuser is "postgres".
# Docker Compose (docker-compose.yml "postgres" service): user/pass/db default to dyafa/dyafa/dyafa_development.
DATABASE_URL="postgresql://dyafa:dyafa@localhost:5432/dyafa_development?schema=public"
POSTGRES_USER=dyafa
POSTGRES_PASSWORD=dyafa
POSTGRES_DB=dyafa_development

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET="[NEEDS VERIFICATION: generate a random 32+ byte secret for production]"

# --- Admin seed user (used by prisma/seed.ts) ---
ADMIN_SEED_EMAIL="admin@dyafa.com"
ADMIN_SEED_PASSWORD="ChangeMe123!"
ADMIN_SEED_NAME="Dyafa Admin"

# --- Mail ---
# MAIL_PROVIDER: "console" (dev, logs to stdout) | "smtp" | "resend"
MAIL_PROVIDER="console"
MAIL_FROM="Dyafa Development <no-reply@dyafa.com>"
SMTP_HOST="[NEEDS VERIFICATION: production SMTP host]"
SMTP_PORT=587
SMTP_USER="[NEEDS VERIFICATION]"
SMTP_PASSWORD="[NEEDS VERIFICATION]"
RESEND_API_KEY="[NEEDS VERIFICATION: only if MAIL_PROVIDER=resend]"
BD_NOTIFICATION_EMAILS="bd@dyafa.com"

# --- WhatsApp ---
WHATSAPP_NUMBER="[NEEDS VERIFICATION: WhatsApp Business number, E.164 without +]"

# --- Analytics ---
NEXT_PUBLIC_ANALYTICS_PROVIDER="none"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="[NEEDS VERIFICATION]"
NEXT_PUBLIC_GA4_ID="[NEEDS VERIFICATION]"

# --- Storage ---
# STORAGE_DRIVER: "local" (dev, disk under /storage/uploads) | "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
S3_ENDPOINT="[NEEDS VERIFICATION]"
S3_BUCKET="[NEEDS VERIFICATION]"
S3_ACCESS_KEY_ID="[NEEDS VERIFICATION]"
S3_SECRET_ACCESS_KEY="[NEEDS VERIFICATION]"
S3_REGION="[NEEDS VERIFICATION]"

# --- Feature flags ---
FEATURE_PROJECTS=false

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# --- Background jobs ---
JOB_RUNNER_MODE="inline"
CRON_SECRET="[NEEDS VERIFICATION: random secret shared with the scheduler calling /api/cron/*]"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
